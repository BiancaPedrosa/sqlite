<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Editar Aluno</title>
</head>
<body>

    <h2>Editar Dados do Aluno</h2>

    <form action="/update/<%= aluno.id %>" method="POST">
        
        <div>
            <label for="nome">Nome do Aluno:</label>
            <input type="text" id="nome" name="nome" value="<%= aluno.nome %>" required>
        </div>

        <br>

        <div>
            <label for="idade">Idade:</label>
            <input type="number" id="idade" name="idade" value="<%= aluno.idade %>" required>
        </div>

        <br>

        <button type="submit">Salvar Alterações</button>
        <a href="/select">Cancelar</a>
    </form>

</body>
</html>